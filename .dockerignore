# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Include the pinned client lockfiles and their installer for client images
!hack/clients/install.sh
!hack/clients/*/package.json
!hack/clients/*/package-lock.json

# Include every harness launch file embedded in the manager binary; new launch
# files go in this directory (see docs/contributing/add-a-harness.md)
!internal/harness/launchfiles/

# Include the Sproozi instructions and skill embedded in every harness launch
!internal/harness/managed/*.md
