{
  "version": 1,
  "description": "Required Sproozi acceptance assertions. This file declares the contract; a declaration is not evidence of a passing runtime test.",
  "assertions": [
    {"id":"API-01","domain":"api","description":"Task and template immutability","expected_decision":"allow valid object; deny mutation","forbidden_side_effects":"persist mutated object"},
    {"id":"API-02","domain":"api","description":"Capability immutability","expected_decision":"deny capability mutation","forbidden_side_effects":"persist changed capability"},
    {"id":"API-03","domain":"api","description":"Malformed capability and package scope","expected_decision":"deny malformed or out-of-scope value","forbidden_side_effects":"create grant"},
    {"id":"API-04","domain":"api","description":"Wildcard capability rejection","expected_decision":"deny wildcard","forbidden_side_effects":"broaden authorization"},
    {"id":"API-05","domain":"api","description":"Unsafe runtime fields and mandatory limits","expected_decision":"deny unsafe or unbounded runtime","forbidden_side_effects":"create unsafe pod"},
    {"id":"ID-01","domain":"identity","description":"Valid service-account identity","expected_decision":"allow exact namespace, name, UID and run UID","forbidden_side_effects":"accept another identity"},
    {"id":"ID-02","domain":"identity","description":"Same service-account name in wrong namespace","expected_decision":"deny","forbidden_side_effects":"select wrong namespace run"},
    {"id":"ID-03","domain":"identity","description":"Service-account UID or run UID mismatch","expected_decision":"deny","forbidden_side_effects":"bind mismatched run"},
    {"id":"ID-04","domain":"identity","description":"Wrong token audience","expected_decision":"deny","forbidden_side_effects":"accept token for another gateway"},
    {"id":"ID-05","domain":"identity","description":"Expired token","expected_decision":"deny","forbidden_side_effects":"accept expired identity"},
    {"id":"ID-06","domain":"identity","description":"Terminal, cancelled or deleted run","expected_decision":"deny","forbidden_side_effects":"authorize inactive run"},
    {"id":"ID-07","domain":"identity","description":"Token rotation on persistent client","expected_decision":"old token denied and new token accepted","forbidden_side_effects":"reuse revoked token"},
    {"id":"K8S-01","domain":"kubernetes","description":"Allowed resource read","expected_decision":"allow declared read","forbidden_side_effects":"grant undeclared resource"},
    {"id":"K8S-02","domain":"kubernetes","description":"No capability means no RBAC","expected_decision":"deny","forbidden_side_effects":"create read grant"},
    {"id":"K8S-03","domain":"kubernetes","description":"Resource subset enforcement","expected_decision":"deny outside subset","forbidden_side_effects":"widen role"},
    {"id":"K8S-04","domain":"kubernetes","description":"Wrong namespace","expected_decision":"deny","forbidden_side_effects":"read another namespace"},
    {"id":"K8S-05","domain":"kubernetes","description":"Secrets and ConfigMaps denied","expected_decision":"deny","forbidden_side_effects":"read secret or config"},
    {"id":"K8S-06","domain":"kubernetes","description":"Exec attach port-forward and writes denied","expected_decision":"deny","forbidden_side_effects":"mutate or attach"},
    {"id":"K8S-07","domain":"kubernetes","description":"Policy reduction revokes existing bindings","expected_decision":"old access denied after reduction","forbidden_side_effects":"retain stale grant"},
    {"id":"POD-01","domain":"pod","description":"Non-root, capabilities and seccomp","expected_decision":"pod has required hardening","forbidden_side_effects":"run privileged"},
    {"id":"POD-02","domain":"pod","description":"Read-only root filesystem","expected_decision":"root is read-only","forbidden_side_effects":"write outside approved mounts"},
    {"id":"POD-03","domain":"pod","description":"Permitted ephemeral writes","expected_decision":"approved workspace writes succeed","forbidden_side_effects":"write host or unbounded storage"},
    {"id":"POD-04","domain":"pod","description":"Resource and time bounds","expected_decision":"limits enforced","forbidden_side_effects":"run without bounds"},
    {"id":"POD-05","domain":"pod","description":"Provider secrets and CA private key absent","expected_decision":"not present in sandbox","forbidden_side_effects":"expose credentials"},
    {"id":"GH-01","domain":"github","description":"Clone and fetch","expected_decision":"allow declared repository read","forbidden_side_effects":"access another repository"},
    {"id":"GH-02","domain":"github","description":"Ordinary run-owned branch push","expected_decision":"allow","forbidden_side_effects":"push non-owned ref"},
    {"id":"GH-03","domain":"github","description":"Ordinary gh create and view","expected_decision":"allow after verified read-back","forbidden_side_effects":"return invalid upstream identity"},
    {"id":"GH-04","domain":"github","description":"Other repository denied","expected_decision":"deny","forbidden_side_effects":"forward request"},
    {"id":"GH-05","domain":"github","description":"Non-run ref, tag and delete denied","expected_decision":"deny","forbidden_side_effects":"mutate ref"},
    {"id":"GH-06","domain":"github","description":"Repeated and force update denied","expected_decision":"deny","forbidden_side_effects":"overwrite history"},
    {"id":"GH-07","domain":"github","description":"Wrong pull-request head or base denied","expected_decision":"deny","forbidden_side_effects":"return invalid pull request"},
    {"id":"GH-08","domain":"github","description":"Fragmented, malformed or multi-ref pack denied atomically","expected_decision":"deny with no partial mutation","forbidden_side_effects":"accept partial push"},
    {"id":"GH-09","domain":"github","description":"Aliased, fragmented or mixed GraphQL mutation bypass denied","expected_decision":"deny","forbidden_side_effects":"forward unauthorized mutation"},
    {"id":"GH-10","domain":"github","description":"Unsupported API, path or credential forwarding denied","expected_decision":"deny","forbidden_side_effects":"proxy unsupported request"},
    {"id":"PKG-01","domain":"packages","description":"Pinned wheel installation","expected_decision":"allow locked wheel","forbidden_side_effects":"deliver unpinned bytes"},
    {"id":"PKG-02","domain":"packages","description":"Installed tool actually runs","expected_decision":"allow declared executable","forbidden_side_effects":"claim install without execution"},
    {"id":"PKG-03","domain":"packages","description":"Allowed locked dependencies","expected_decision":"allow only lock entries","forbidden_side_effects":"deliver unlisted dependency"},
    {"id":"PKG-04","domain":"packages","description":"Unlisted name, version or dependency denied","expected_decision":"deny","forbidden_side_effects":"deliver package bytes"},
    {"id":"PKG-05","domain":"packages","description":"Bad digest or size denied","expected_decision":"deny","forbidden_side_effects":"install unverified bytes"},
    {"id":"PKG-06","domain":"packages","description":"Source, VCS and upload denied","expected_decision":"deny","forbidden_side_effects":"execute source build or upload"},
    {"id":"PKG-07","domain":"packages","description":"Metadata and CDN redirect scope enforced","expected_decision":"deny out-of-scope redirect","forbidden_side_effects":"follow arbitrary redirect"},
    {"id":"NET-01","domain":"network","description":"Standard proxy success","expected_decision":"allow declared route","forbidden_side_effects":"bypass inspection"},
    {"id":"NET-02","domain":"network","description":"Unset or overridden proxy bypass blocked","expected_decision":"deny","forbidden_side_effects":"direct provider access"},
    {"id":"NET-03","domain":"network","description":"SSH, QUIC and direct IP blocked","expected_decision":"deny","forbidden_side_effects":"bypass gateway"},
    {"id":"NET-04","domain":"network","description":"Arbitrary CONNECT denied","expected_decision":"deny","forbidden_side_effects":"tunnel arbitrary host"},
    {"id":"NET-05","domain":"network","description":"Host, SNI and path confusion denied","expected_decision":"deny","forbidden_side_effects":"route confused identity"},
    {"id":"NET-06","domain":"network","description":"Redirect, DNS rebinding and private IP denied","expected_decision":"deny","forbidden_side_effects":"reach private address"},
    {"id":"NET-07","domain":"network","description":"Untrusted upstream inspection certificate fails","expected_decision":"deny","forbidden_side_effects":"accept invalid TLS"},
    {"id":"NET-08","domain":"network","description":"Pre-existing connection denied or closed on revocation","expected_decision":"deny after revocation","forbidden_side_effects":"retain live access"},
    {"id":"MOD-01","domain":"model","description":"Pinned Codex protocol","expected_decision":"allow compatible protocol","forbidden_side_effects":"accept unsupported protocol"},
    {"id":"MOD-02","domain":"model","description":"Missing capability denied","expected_decision":"deny","forbidden_side_effects":"forward inference"},
    {"id":"MOD-03","domain":"model","description":"Concurrent budget accounting","expected_decision":"admit only within budget","forbidden_side_effects":"overspend"},
    {"id":"MOD-04","domain":"model","description":"UID, restart and policy-change behavior","expected_decision":"match documented guarantee","forbidden_side_effects":"reuse stale reservation"},
    {"id":"MOD-05","domain":"model","description":"Streaming and missing usage policy","expected_decision":"exercise documented decision","forbidden_side_effects":"accept unverifiable usage"},
    {"id":"RES-01","domain":"result","description":"Zero agent exit","expected_decision":"mark success","forbidden_side_effects":"require an external artefact"},
    {"id":"RES-02","domain":"result","description":"Nonzero agent exit","expected_decision":"mark failure","forbidden_side_effects":"report success"},
    {"id":"RES-03","domain":"result","description":"Unavailable container exit","expected_decision":"mark failure","forbidden_side_effects":"infer success from logs"},
    {"id":"RES-04","domain":"result","description":"Process exits after valid work without a PR","expected_decision":"mark success","forbidden_side_effects":"require a provider action"},
    {"id":"RES-05","domain":"result","description":"Signal termination outside controller cancellation","expected_decision":"mark failure","forbidden_side_effects":"report success"},
    {"id":"RES-06","domain":"result","description":"Agent output is diagnostic only","expected_decision":"ignore output for completion","forbidden_side_effects":"infer outcome from logs"},
    {"id":"LIFE-01","domain":"lifecycle","description":"Success cleanup","expected_decision":"remove run-owned resources","forbidden_side_effects":"orphan grant or pod"},
    {"id":"LIFE-02","domain":"lifecycle","description":"Failure cleanup","expected_decision":"remove run-owned resources","forbidden_side_effects":"orphan grant or pod"},
    {"id":"LIFE-03","domain":"lifecycle","description":"Timeout cleanup","expected_decision":"remove run-owned resources","forbidden_side_effects":"orphan grant or pod"},
    {"id":"LIFE-04","domain":"lifecycle","description":"Cancel cleanup","expected_decision":"remove run-owned resources","forbidden_side_effects":"orphan grant or pod"},
    {"id":"LIFE-05","domain":"lifecycle","description":"Explicit delete and finalizer","expected_decision":"wait for cleanup then remove finalizer","forbidden_side_effects":"delete before cleanup"},
    {"id":"LIFE-06","domain":"lifecycle","description":"Partial admission restart","expected_decision":"resume idempotently","forbidden_side_effects":"duplicate grant or pod"},
    {"id":"LIFE-07","domain":"lifecycle","description":"Missing template or policy cleanup","expected_decision":"fail closed and clean","forbidden_side_effects":"run without immutable inputs"},
    {"id":"LIFE-08","domain":"lifecycle","description":"Retained result TTL and no orphan resources","expected_decision":"retain bounded result then expire","forbidden_side_effects":"retain credentials or grants"},
    {"id":"DOC-01","domain":"docs","description":"Local links and anchors resolve","expected_decision":"pass","forbidden_side_effects":"ship broken link"},
    {"id":"DOC-02","domain":"docs","description":"No private-file references","expected_decision":"pass","forbidden_side_effects":"leak private plan"},
    {"id":"DOC-03","domain":"docs","description":"Base manual install has no metrics prerequisite","expected_decision":"pass","forbidden_side_effects":"require optional overlay"},
    {"id":"DOC-04","domain":"docs","description":"Compatibility and security statements match fixtures","expected_decision":"pass","forbidden_side_effects":"document unsupported behavior"},
    {"id":"PUB-01","domain":"public-tree","description":"Skills are untracked","expected_decision":"pass","forbidden_side_effects":"publish private skills"},
    {"id":"PUB-02","domain":"public-tree","description":"PRD, plans and context are untracked","expected_decision":"pass","forbidden_side_effects":"publish private planning"},
    {"id":"PUB-03","domain":"public-tree","description":"Ignored local files excluded in export","expected_decision":"pass","forbidden_side_effects":"include local artifacts"},
    {"id":"PUB-04","domain":"public-tree","description":"Architecture, guides and references preserved","expected_decision":"pass","forbidden_side_effects":"remove public documentation"}
  ]
}
