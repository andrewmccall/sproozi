FROM golang:1.26.11-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY hack/verify/orchestration-kind/provider/*.go ./hack/verify/orchestration-kind/provider/
RUN CGO_ENABLED=0 go build -o /provider ./hack/verify/orchestration-kind/provider
FROM scratch
COPY --from=build /provider /provider
USER 65532:65532
ENTRYPOINT ["/provider"]
